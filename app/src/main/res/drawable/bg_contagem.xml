<?xml version="1.0" encoding="utf-8"?>
<!-- Círculo da contagem regressiva na tela de alerta -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item android:bottom="18dp" android:left="18dp" android:right="18dp" android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#26000000" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
