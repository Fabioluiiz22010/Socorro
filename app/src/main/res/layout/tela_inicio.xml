<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Situação da proteção (a cor muda pelo código) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="fixo"
            app:cardBackgroundColor="@color/socorro_preto"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:contentPadding="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="fixo">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:tag="fixo">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circulo_escudo">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_escudo"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:tag="fixo">

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:tag="fixo"
                            android:text="Proteção desligada"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/txtStatusDetalhe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.85"
                            android:lineSpacingMultiplier="1.15"
                            android:tag="fixo"
                            android:text="Ative para detectar quedas mesmo com o app fechado."
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProtecao"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:text="Ativar proteção"
                    android:textAllCaps="false"
                    android:textColor="@color/socorro_preto"
                    android:textSize="18sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="30dp"
                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Banner vermelho de emergência: o cartão inteiro é o botão -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPanico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:contentDescription="SOS. Toque para pedir ajuda"
            android:focusable="true"
            android:tag="fixo"
            app:cardBackgroundColor="@color/socorro_vermelho"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/socorro_vermelho_escuro"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="150dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp"
                android:tag="fixo">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:tag="fixo">

                    <TextView
                        style="@style/Socorro.Selo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_selo_claro"
                        android:tag="fixo"
                        android:text="EMERGÊNCIA"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:tag="fixo"
                        android:text="Precisa de ajuda?"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.15"
                        android:tag="fixo"
                        android:text="Toque no SOS. Você ainda tem 5 segundos para cancelar."
                        android:textColor="#FFE3E5"
                        android:textSize="15sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_anel_sos"
                    android:importantForAccessibility="noHideDescendants">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:tag="fixo"
                        android:text="SOS"
                        android:textColor="@color/socorro_vermelho"
                        android:textSize="30sp" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Socorro.Secao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="Agora" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Clima: o cartão todo atualiza -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnClima"
                style="@style/Socorro.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Socorro.IconeChip"
                        android:background="@drawable/bg_chip_azul"
                        android:src="@drawable/ic_nuvem"
                        app:tint="@color/socorro_azul" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:tag="sec"
                        android:text="Clima"
                        android:textColor="@color/socorro_texto_2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtClimaResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="—"
                        android:textColor="@color/socorro_texto"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/txtClima"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="3"
                        android:tag="sec"
                        android:text="Toque em atualizar"
                        android:textColor="@color/socorro_texto_2"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:tag="fixo"
                        android:text="Atualizar  ›"
                        android:textColor="@color/socorro_azul"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Socorro.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Socorro.IconeChip"
                        android:background="@drawable/bg_chip_verde"
                        android:src="@drawable/ic_enviar"
                        app:tint="@color/socorro_verde" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:tag="sec"
                        android:text="Central"
                        android:textColor="@color/socorro_texto_2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtApiResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:tag="fixo"
                        android:text="—"
                        android:textColor="@color/socorro_texto_2"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/txtApi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="3"
                        android:tag="sec"
                        android:text="Nenhum envio ainda"
                        android:textColor="@color/socorro_texto_2"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            style="@style/Socorro.Secao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="Atalhos" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socorro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:contentPadding="0dp">

            <LinearLayout
                android:id="@+id/btnSimular"
                style="@style/Socorro.Linha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/Socorro.IconeChip"
                    android:src="@drawable/ic_play" />

                <LinearLayout style="@style/Socorro.LinhaTexto">

                    <TextView
                        style="@style/Socorro.TextoForte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Testar a detecção" />

                    <TextView
                        style="@style/Socorro.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="sec"
                        android:text="Simula uma queda para ver o alerta"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView style="@style/Socorro.Seta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
