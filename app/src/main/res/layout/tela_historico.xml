<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Socorro.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Histórico" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimpar"
                style="@style/Socorro.BotaoTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@color/socorro_vermelho_escuro"
                app:icon="@drawable/ic_lixeira"
                app:iconSize="20dp"
                app:iconTint="@color/socorro_vermelho_escuro"
                app:rippleColor="@color/socorro_vermelho_claro" />
        </LinearLayout>

        <TextView
            style="@style/Socorro.TextoSec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:tag="sec"
            android:text="Quedas, pedidos de ajuda e alarmes cancelados neste celular."
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socorro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:contentPadding="0dp"
            app:contentPaddingBottom="4dp"
            app:contentPaddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lista vazia -->
                <TextView
                    android:id="@+id/txtHistoricoVazio"
                    style="@style/Socorro.TextoSec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_relogio"
                    android:drawablePadding="14dp"
                    android:drawableTint="#BDBDBD"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingTop="44dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="44dp"
                    android:tag="sec"
                    android:text="Nada por aqui ainda.\nO que acontecer vai aparecer nesta lista." />

                <LinearLayout
                    android:id="@+id/listaHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Socorro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:contentPadding="0dp">

            <LinearLayout
                android:id="@+id/btnPainel"
                style="@style/Socorro.Linha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/Socorro.IconeChip"
                    android:src="@drawable/ic_abrir" />

                <LinearLayout style="@style/Socorro.LinhaTexto">

                    <TextView
                        style="@style/Socorro.TextoForte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Painel da central" />

                    <TextView
                        style="@style/Socorro.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="sec"
                        android:text="Ver os alertas no site"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView style="@style/Socorro.Seta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
